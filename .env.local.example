# Локальная разработка: бэкенд на вашем компьютере
# Скопируйте в .env и подставьте свой IP (для телефона в Wi-Fi) или оставьте для эмулятора.

# Базовый URL бэкенда без /api/ (например http://192.168.1.100:8000)
# Для эмулятора/Web можно не задавать — по умолчанию localhost / 10.0.2.2
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
